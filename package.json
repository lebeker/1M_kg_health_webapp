{
  "name": "health-viewer",
  "private": true,
  "version": "0.0.55",
  "type": "module",
  "description": "Single-file React viewer for a kg/1-health document — the template half of the health map.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/build-demo.ts && bun scripts/build-case.ts",
    "build:local": "vite build",
    "build:multi": "KG_BUILD=multi vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts",
    "lint:fix": "biome lint --write src scripts",
    "test": "bun test src scripts",
    "test:contract": "bun scripts/validate-kg-fixtures.ts",
    "test:branch-name": "bun scripts/check-branch-name.ts --self-test",
    "test:release": "bun test scripts/release.test.ts",
    "e2e": "bun scripts/e2e/run.ts",
    "review": "bun scripts/review.ts",
    "review:gate": "bun scripts/review-gate.ts",
    "rules": "bun scripts/rules.ts",
    "verify": "bun run lint && bun run typecheck && bun run check:case && bun run build:demo && bun run test && bun run test:contract && bun run test:branch-name && bun run test:split",
    "bundle": "node scripts/bundle.mjs",
    "build:demo": "bun scripts/build-demo.ts",
    "check:demo": "bun scripts/build-demo.ts --check",
    "build:case": "bun scripts/build-case.ts",
    "check:case": "bun scripts/build-case.ts --check",
    "release": "node scripts/release.mjs",
    "test:fold": "bun test src/fold.test.ts",
    "score2": "bun scripts/score2.ts",
    "lee": "bun scripts/lee.ts",
    "explain": "bun scripts/explain.ts",
    "strategies": "bun scripts/strategies.ts",
    "test:split": "node body/tools/split-regression.mjs"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.1",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
