node_modules/
dist/
dist-multi/
.DS_Store
# G3 evidence: runs are inspected locally and attached to the card, not committed.
.e2e/

# Test scratch space, kept inside the repo so a test run writes nothing outside it.
.cache/
skills/**/__pycache__/

# --- Models -------------------------------------------------------------------
# body/models is content, not build output: the sixteen models body/index.html loads are
# tracked on purpose (docs/RELEASE.md §5). What a rebuild drops beside them is not.
body/models/**/*.blend1
body/models/**/*.blend2
body/models/**/*.blend@
body/models/**/*.glb.tmp
body/models/**/*.npz
body/models/**/volume-cache/
# Candidate exports that were never installed into the page.
body/models/repair/reproductive-female.glb
body/tools/__pycache__/
scripts/__pycache__/
